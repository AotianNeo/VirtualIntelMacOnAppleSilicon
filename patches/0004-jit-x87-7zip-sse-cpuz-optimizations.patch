+// Fast EL0 FLD m80 (DB /5)
+static void load_m80_fast(const Insn *in) {
+    SlowList sl = {.n = 0};
+    emit_x87_guard(&sl);
+    ldst(1, 2, S1, (Addr){.base = AD, .imm = 8});
+    ubfx(0, S4, S1, 0, 15);
+    u32 *is_zero = tr_cc;
+    cbz(0, 0, S4, 0);
+
+    movimm(S2, 15361);
+    add_reg(0, 1, 0, S4, S4, S2, 0);
+    lsr_imm(0, S2, S4, 11);
+    add_cbz(&sl, 1, 0, S2);
+    add_imm(0, 0, 0, S2, S4, 2);
+    add_tbz(&sl, 1, S2, 11);
+
+    add_imm(0, 0, 0, S4, S4, 1);
+    ubfx(1, S0, S0, 11, 52);
+    bfi(1, S0, S4, 52, 11);
+    ubfx(1, S2, S1, 15, 1);
+    bfi(1, S0, S2, 63, 1);
+    u32 *have_d = tr_cc;
+    b_rel(0);
+
+    patch_cbz_here(is_zero);
+    add_cbz(&sl, 1, 1, S0);
+    ubfx(1, S0, S1, 15, 1);
+    lsl_imm(1, S0, S0, 63);
+
+    patch_b(have_d);
+    emit_push_cached_x64(S0, &sl);
+    u32 *done = tr_cc;
+    b_rel(0);
+
+    patch_slow(&sl);
+    ldst(1, 8, S0, (Addr){.base = AD});
+    ldst(1, 2, S1, (Addr){.base = AD, .imm = 8});
+    call_monitor(in);
+    patch_b(done);
+}
