+            0x400A934F0979A371ULL, // log2(10)
+            0x3FF71547652B82FEULL, // log2(e)
+            0x400921FB54442D18ULL, // pi
+            0x3FD34413509F79FFULL, // log10(2)
+            0x3FE62E42FEFA39EFULL, // ln(2)
+            0x0000000000000000ULL, // 0.0
