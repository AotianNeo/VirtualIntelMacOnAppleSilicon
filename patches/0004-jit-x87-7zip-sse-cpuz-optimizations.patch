+    ldst(1, 8, S4, (Addr){.base = S1, .imm = offsetof(EngineCtx, mm)});
+    add_reg(1, 0, 0, S1, CTX, phys, 1);
+    ldst(1, 2, S5, (Addr){.base = S1, .imm = offsetof(EngineCtx, fp_exp)});
+    ubfx(0, S1, S5, 0, 15); // exp80
+    u32 *is_zero = tr_cc;
+    cbz(0, 0, S1, 0);
