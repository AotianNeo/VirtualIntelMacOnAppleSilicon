+// Fast register-register x87 ops.
+static bool try_fast_reg(const Insn *in) {
+    int esc = in->sub, m = in->opc, reg = (m >> 3) & 7, rm = m & 7;
+
+    // FWAIT (9B)
+    if (esc == 8) {
+        SlowList sl = {.n = 0};
+        emit_x87_guard(&sl);
+        u32 *done = tr_cc;
+        b_rel(0);
+        patch_slow(&sl);
+        call_monitor(in);
+        patch_b(done);
+        return true;
+    }
+
+    // DF E0: FNSTSW AX
+    if (esc == 7 && m == 0xE0) {
+        SlowList sl = {.n = 0};
+        ldst(1, 8, S1, (Addr){.base = CTX, .imm = offsetof(EngineCtx, cr0)});
+        movimm(S5, 0xC);
+        logic_reg(1, 0, 0, S1, S1, S5);
+        add_cbz(&sl, 1, 1, S1);
+        ldst(1, 4, S3, (Addr){.base = CTX, .imm = offsetof(EngineCtx, fp_top)});
+        lsr_imm(0, S0, S3, 16);
+        ubfx(0, S1, S3, 0, 3);
+        bfi(0, S0, S1, 11, 3);
+        gpr_write(0, 2, false, S0);
+        u32 *done = tr_cc;
+        b_rel(0);
+        patch_slow(&sl);
+        call_monitor(in);
+        gpr_write(0, 2, false, S0);
+        patch_b(done);
+        return true;
+    }
+
+    // D9 D0: FNOP
+    if (esc == 1 && m == 0xD0) {
+        SlowList sl = {.n = 0};
+        emit_x87_guard(&sl);
+        u32 *done = tr_cc;
+        b_rel(0);
+        patch_slow(&sl);
+        call_monitor(in);
+        patch_b(done);
+        return true;
+    }
