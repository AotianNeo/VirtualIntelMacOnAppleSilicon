+// Lossless EL0 FILD m16 (DF /0) and FILD m32 (DB /0)
+static void fild_int32_fast(const Insn *in, bool is16) {
+    SlowList sl = {.n = 0};
+    emit_x87_guard(&sl);
+    if (is16)
+        sbfx(0, S0, S0, 0, 16);
+    scvtf_d_w(V_S0, S0);
+    fmov_x_d(S0, V_S0);
+    emit_push_cached_x64(S0, &sl);
+    u32 *done = tr_cc;
+    b_rel(0);
+
+    patch_slow(&sl);
+    ldst(1, is16 ? 2 : 4, S0, (Addr){.base = AD});
+    call_monitor(in);
+    patch_b(done);
+}
