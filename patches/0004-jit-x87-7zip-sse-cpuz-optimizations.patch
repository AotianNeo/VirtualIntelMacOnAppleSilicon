+        logic_reg(0, 0, 0, S1, S1, S2);
+        add_cbz(&sl, 1, 0, S1);
+        ldst(0, 2, S0, (Addr){.base = CTX, .imm = offsetof(EngineCtx, fcw)});
+    }
+    u32 *done = tr_cc;
+    b_rel(0);
+
+    patch_slow(&sl);
+    call_monitor(in);
+    if (is_store) {
+        ldst(0, 2, S0, a);
+        ldst(0, 4, S3, (Addr){.base = CTX, .imm = offsetof(EngineCtx, fp_top)});
