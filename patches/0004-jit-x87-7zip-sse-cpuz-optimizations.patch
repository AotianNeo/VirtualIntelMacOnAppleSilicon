+    ldst(1, 8, S4, (Addr){.base = CTX, .imm = offsetof(EngineCtx, fp_d_valid)});
+    movimm(S5, 1);
+    var_shift(0, 0, S5, S5, phys);
+    logic_reg(0, 1, 0, S4, S4, S5);
+    ldst(0, 8, S4, (Addr){.base = CTX, .imm = offsetof(EngineCtx, fp_d_valid)});
+}
