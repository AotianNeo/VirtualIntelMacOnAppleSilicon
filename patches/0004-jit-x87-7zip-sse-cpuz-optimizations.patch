+// Fast EL0 FSTP m80 (DB /7)
+static void store_m80_fast(const Insn *in, Addr a, Addr hi) {
+    SlowList sl = {.n = 0};
+    emit_x87_guard(&sl);
+    emit_st_phys_nonempty(S0, 0, &sl);
+    emit_load_cached_d(S0, V_S0, &sl);
+    fmov_x_d(S4, V_S0);
+    ubfx(1, S1, S4, 52, 11);
+    u32 *is_zero = tr_cc;
+    cbz(0, 0, S1, 0);
+
+    add_imm(0, 0, 0, S2, S1, 1);
+    add_tbz(&sl, 1, S2, 11);
+
+    movimm(S2, 15360);
+    add_reg(0, 0, 0, S5, S1, S2, 0);
+    ubfx(1, S2, S4, 63, 1);
+    bfi(0, S5, S2, 15, 1);
+    lsl_imm(1, S4, S4, 11);
+    movimm(S2, 1ULL << 63);
+    logic_reg(1, 1, 0, S4, S4, S2);
+    u32 *do_store = tr_cc;
+    b_rel(0);
+
+    patch_cbz_here(is_zero);
+    ubfx(1, S2, S4, 0, 52);
+    add_cbz(&sl, 1, 1, S2);
+    ubfx(1, S5, S4, 63, 1);
+    lsl_imm(0, S5, S5, 15);
+    movimm(S4, 0);
