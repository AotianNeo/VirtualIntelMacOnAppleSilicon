+    if (is32) {
+        fmov_s_w(V_S0, S0);
+        fcvt_d_s(V_S0, V_S0);
+        fmov_x_d(S0, V_S0);
+    }
+    emit_push_cached_x64(S0, &sl);
+    u32 *done = tr_cc;
+    b_rel(0);
+
+    patch_slow(&sl);
